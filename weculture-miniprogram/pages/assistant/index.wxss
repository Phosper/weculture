.assistant { display:flex; flex-direction:column; min-height:calc(100vh - 48rpx); }.intro-card { display:flex; align-items:center; gap:16rpx; }.c-avatar { width:64rpx; height:64rpx; line-height:64rpx; text-align:center; color:#FFFFFF; background:#C5532E; border-radius:50%; font-size:34rpx; }.intro-title { font-size:30rpx; font-weight:700; }.messages { flex:1; min-height:650rpx; padding:28rpx 0; }.message { max-width:78%; padding:18rpx 22rpx; border-radius:16rpx; line-height:1.6; margin-bottom:18rpx; box-sizing:border-box; }.message.assistant { background:#FFFFFF; border:1rpx solid #E6DED9; border-top-left-radius:4rpx; }.message.user { margin-left:auto; background:#C5532E; color:#FFFFFF; border-top-right-radius:4rpx; }.quick { display:flex; flex-wrap:wrap; gap:12rpx; }.quick-item { color:#8C391D; background:#FDE8DD; border-radius:999rpx; padding:10rpx 16rpx; font-size:23rpx; }.composer { display:flex; gap:14rpx; padding-top:22rpx; }.composer input { flex:1; background:#FFFFFF; border:1rpx solid #E6DED9; border-radius:12rpx; padding:0 16rpx; min-height:76rpx; }.send { margin:0; font-size:24rpx; line-height:2.5; }
