<page-meta page-style="{{fontPageStyle}}" />
<view class="topbar" style="padding-top:{{statusBarHeight}}px;height:{{navBarHeight}}px"><view class="topbar-inner" style="height:{{navContentHeight}}px;padding-right:{{navRightInset}}px"><view class="brand-lockup"><text class="topbar-brand">Weculture</text><text class="brand-subtitle">让文化融入生活</text></view></view></view>
<view class="page tab-page publish-page">
  <view class="publish-intro"><view class="title">分享你的文化故事</view><view class="subtle">一张照片、一场活动，都能让更多人走近文化。</view></view>
  <view class="tabs"><view wx:for="{{['dynamic','event','market']}}" wx:key="*this" class="tab {{type === item ? 'active' : ''}}" data-type="{{item}}" bindtap="selectType">{{item === 'dynamic' ? '动态' : item === 'event' ? '活动' : '闲置'}}</view></view>
  <view class="card form">
    <view class="label">发布到</view><view class="audience"><view class="{{circle === 'city' ? 'active' : ''}}" data-circle="city" bindtap="selectCircle">同城</view><view class="{{circle === 'international' ? 'active' : ''}}" data-circle="international" bindtap="selectCircle">国际圈</view><view class="{{circle === 'campus' ? 'active' : ''}}" data-circle="campus" bindtap="selectCircle">校园圈</view></view>
    <block wx:if="{{circle === 'city'}}"><view class="label">发布城市</view><picker disabled="{{submitting}}" mode="region" value="{{cityRegion}}" bindchange="chooseCity"><view class="language-picker city-picker"><view class="{{!city ? 'city-placeholder' : ''}}">{{city || '请选择城市'}}</view><text>{{city ? '更换 ›' : '选择 ›'}}</text></view></picker><view wx:if="{{automaticCityLocationEnabled}}" class="publish-location-tools"><button class="button-plain locate-button" loading="{{locating}}" disabled="{{submitting || locating || !user}}" bindtap="locateCity">{{locating ? '定位中' : '定位当前城市'}}</button></view><view class="city-hint">按城市展示，只公开城市名称，可手动更换。</view><view wx:if="{{automaticCityLocationEnabled && locationError}}" class="location-error">{{locationError}}<button wx:if="{{locationSettings}}" class="button-plain locate-button" bindtap="openLocationSettings">去开启定位</button></view></block>
    <block wx:if="{{circle === 'international'}}"><view class="label">内容语言</view><picker disabled="{{submitting}}" range="{{languages}}" range-key="label" value="{{languageIndex}}" bindchange="selectLanguage"><view class="language-picker">{{languages[languageIndex].label}}<text>更换 ›</text></view></picker></block>
    <view wx:if="{{circle === 'campus'}}" class="audience-note"><view>{{user.verified && user.school ? user.school.name + ' · 仅本校认证成员可见' : '校园圈需要学校认证'}}</view><button wx:if="{{!user.verified}}" size="mini" class="button-plain verify-button" bindtap="verify">去认证</button></view>
    <view wx:else class="audience-note">{{circles[circle].notice}}</view>
    <view class="label">标题</view><input disabled="{{submitting}}" data-field="title" value="{{title}}" maxlength="40" placeholder="说说你想分享的事" bindinput="input" />
    <view class="label">正文</view><textarea disabled="{{submitting}}" data-field="content" value="{{content}}" maxlength="2000" placeholder="分享文化体验、活动或闲置信息" bindinput="input" />
    <view class="label">添加图片</view><view wx:if="{{imageTempPath}}" class="media-preview"><image src="{{imageTempPath}}" mode="aspectFill"/><text bindtap="removeImage">移除</text></view><view wx:else class="media-add" bindtap="chooseImage"><text>＋</text><text>选一张现场照片</text></view>
    <view class="label">标签</view><input disabled="{{submitting}}" data-field="tag" value="{{tag}}" placeholder="例如：校园文化" bindinput="input" />
    <block wx:if="{{type === 'market'}}"><view class="label">价格（元）</view><input disabled="{{submitting}}" data-field="price" value="{{price}}" type="digit" placeholder="例如：15" bindinput="input" /></block>
    <block wx:if="{{type === 'event'}}"><view class="label">活动地点</view><input disabled="{{submitting}}" data-field="location" value="{{location}}" placeholder="输入活动地点" bindinput="input" />
      <view class="label">开始时间</view><view class="date-row"><picker disabled="{{submitting}}" mode="date" value="{{startDate}}" data-field="startDate" bindchange="pick"><view>{{startDate}}</view></picker><picker disabled="{{submitting}}" mode="time" value="{{startTime}}" data-field="startTime" bindchange="pick"><view>{{startTime}}</view></picker></view>
      <view class="label">结束时间</view><view class="date-row"><picker disabled="{{submitting}}" mode="date" value="{{endDate}}" data-field="endDate" bindchange="pick"><view>{{endDate}}</view></picker><picker disabled="{{submitting}}" mode="time" value="{{endTime}}" data-field="endTime" bindchange="pick"><view>{{endTime}}</view></picker></view>
      <view class="label">报名截止</view><view class="date-row"><picker disabled="{{submitting}}" mode="date" value="{{deadlineDate}}" data-field="deadlineDate" bindchange="pick"><view>{{deadlineDate}}</view></picker><picker disabled="{{submitting}}" mode="time" value="{{deadlineTime}}" data-field="deadlineTime" bindchange="pick"><view>{{deadlineTime}}</view></picker></view>
      <view class="label">人数上限</view><input disabled="{{submitting}}" data-field="capacity" value="{{capacity}}" type="number" bindinput="input" />
    </block>
    <view wx:if="{{error}}" class="error">{{error}}</view><button class="button-primary submit" disabled="{{submitting || locating || !user || (circle === 'campus' && !user.verified)}}" loading="{{submitting}}" bindtap="submit">{{type === 'event' ? '提交活动审核' : '提交审核'}}</button>
  </view><view class="notice">同城与国际圈投稿经平台审核后公开展示；校园圈内容仅本校认证成员可见。</view>
</view>
