<view class="page"><view class="title">文化旅行</view><view class="subtle intro">用你的偏好，生成一条可加入的文化路线。</view><view class="card planner"><view class="label">目的地</view><input value="{{destination}}" placeholder="例如：北京" bindinput="input"/><view class="label">出行天数</view><view class="choices"><view wx:for="{{['1-3天','4-7天','7天以上']}}" wx:key="*this" class="choice {{days === item ? 'selected' : ''}}" data-days="{{item}}" bindtap="chooseDays">{{item}}</view></view><view class="label">旅行偏好</view><view class="choices"><view wx:for="{{options}}" wx:key="label" class="choice {{item.selected ? 'selected' : ''}}" data-value="{{item.label}}" bindtap="togglePreference">{{item.label}}</view></view><button class="button-primary" loading="{{loading}}" bindtap="recommend">生成推荐路线</button></view><view class="section-head"><text class="section-title">推荐路线</text></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{!loading && !routes.length}}" class="empty">暂未找到匹配路线，试试调整条件。</view><view wx:for="{{routes}}" wx:key="id" class="route card"><image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill"/><view class="route-copy"><view class="route-title">{{item.title}}</view><view class="subtle">{{item.stopsText}}</view><view class="highlights">{{item.highlightsText}}</view><view class="route-foot"><text class="price">¥{{item.budget}} / 人</text><button class="button-plain small" data-id="{{item.id}}" bindtap="plan">{{item.planned ? '已加入' : '加入计划'}}</button></view></view></view></view>
