.hero { display:flex; justify-content:space-between; align-items:center; margin:22rpx 0 30rpx; }.brand { font-family:Georgia,serif; font-size:48rpx; font-weight:700; color:#C5532E; }.hero-copy { margin-top:6rpx; color:#756B66; }.avatar { width:72rpx; height:72rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#FFFFFF; background:#8C391D; }.search { height:76rpx; display:flex; align-items:center; background:#FFFFFF; border:1rpx solid #E6DED9; border-radius:12rpx; padding:0 18rpx; color:#8C391D; }.search input { flex:1; }.verify-card,.service { display:flex; align-items:center; justify-content:space-between; margin-top:22rpx; }.verify-title,.service-title { font-size:29rpx; font-weight:700; margin-bottom:8rpx; }.compact { font-size:23rpx; line-height:2.2; padding:0 18rpx; }.service { background:#FDE8DD; border-color:#F3D2C2; }.service-mark { width:58rpx; height:58rpx; margin-right:16rpx; border-radius:50%; color:#FFFFFF; background:#C5532E; text-align:center; line-height:58rpx; font-size:32rpx; }.service > view:nth-child(2) { flex:1; }.more { color:#8C391D; font-size:25rpx; }
