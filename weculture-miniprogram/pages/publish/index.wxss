.tabs { display:flex; background:#FFFFFF; border:1rpx solid #E6DED9; border-radius:14rpx; overflow:hidden; margin:20rpx 0; }.tab { flex:1; padding:20rpx 0; text-align:center; color:#756B66; }.tab.active { color:#FFFFFF; background:#C5532E; }.form { padding:28rpx; }.label { font-size:25rpx; color:#675E5A; margin:22rpx 0 10rpx; }.form input,.form textarea { width:100%; border-bottom:1rpx solid #E6DED9; padding:16rpx 0; box-sizing:border-box; }.form textarea { min-height:180rpx; }.form button { margin-top:34rpx; }.notice { padding:20rpx 10rpx; font-size:23rpx; color:#756B66; line-height:1.6; }
