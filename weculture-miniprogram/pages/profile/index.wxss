.profile { display:flex; align-items:center; margin-top:20rpx; background:#FFF6F1; }.portrait { width:92rpx; height:92rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; background:#C5532E; color:#FFFFFF; font-size:40rpx; }.profile-copy { margin-left:20rpx; }.name,.plan-title,.verify-title { font-weight:700; font-size:32rpx; margin-bottom:8rpx; }.verify { margin-top:18rpx; display:flex; justify-content:space-between; align-items:center; }.short { padding:0 18rpx; font-size:23rpx; line-height:2.1; margin:0; }.plan { margin-bottom:16rpx; }.plan-title { font-size:29rpx; margin-top:16rpx; }.post-status { display:flex; align-items:center; justify-content:space-between; margin-bottom:14rpx; }.post-title { font-size:27rpx; font-weight:600; }.status { padding:8rpx 12rpx; border-radius:999rpx; font-size:22rpx; background:#F6EEE9; color:#756B66; }.status.approved { background:#E7F3EA; color:#2C6B43; }.status.pending { background:#FFF2D5; color:#87651D; }.status.rejected { background:#FCE8E6; color:#A33B32; }.reject { color:#A33B32; font-size:22rpx; margin-top:8rpx; max-width:480rpx; }.logout { color:#8E5D4E; font-size:25rpx; background:transparent; margin-top:40rpx; }.logout::after { border:0; }
