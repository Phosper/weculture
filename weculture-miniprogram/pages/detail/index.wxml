<view class="page"><view wx:if="{{loading}}" class="empty">正在加载...</view><view wx:if="{{error}}" class="error">{{error}}</view><block wx:if="{{post}}"><image wx:if="{{post.imageUrl}}" class="cover" src="{{post.imageUrl}}" mode="aspectFill"/><view class="pill">{{post.tag}}</view><view class="title">{{post.title}}</view><view class="meta">{{post.author.nickname}} · {{post.createdAt}}</view><view class="content">{{post.content}}</view><view wx:if="{{post.event}}" class="event card"><view><view class="event-title">{{post.event.location}}</view><view class="subtle">开始：{{post.event.startsAt}}</view><view class="subtle">报名截止：{{post.event.registrationDeadline}}</view><view class="subtle">{{post.event.registeredCount}} / {{post.event.capacity}} 人已报名</view></view><button class="button-primary event-button" bindtap="register">{{post.event.registered ? '已报名' : '立即报名'}}</button></view><view class="actions"><button class="button-plain" bindtap="like">{{post.liked ? '已点赞' : '点赞'}} {{post.likeCount}}</button><button class="button-plain" bindtap="favorite">{{post.favorited ? '已收藏' : '收藏'}}</button></view></block></view>
