.topbar-inner { justify-content: flex-start; gap: 18rpx; }
.back { font-size: calc(54rpx * var(--font-scale, 1)); line-height: 1; color: #C5532E; }
.assistant-page { position: fixed; left: 0; right: 0; bottom: 0; display: flex; flex-direction: column; padding-top: 18rpx; padding-bottom: 20rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); background: #FCFBF8; }
.events-title { font-size: calc(26rpx * var(--font-scale, 1)); font-weight: 700; margin-bottom: 12rpx; }
.event-scroll { white-space: nowrap; margin-bottom: 18rpx; }
.event-mini { display: inline-flex; width: 300rpx; height: 110rpx; padding: 0; overflow: hidden; margin-right: 14rpx; vertical-align: top; }
.event-mini image { flex-shrink: 0; width: 105rpx; height: 110rpx; }
.event-mini-copy { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 3rpx; padding: 10rpx; min-width: 0; overflow: hidden; }
.event-mini-tag { color: #C5532E; font-size: calc(18rpx * var(--font-scale, 1)); }
.event-mini-title { font-size: calc(21rpx * var(--font-scale, 1)); font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.event-mini .subtle { font-size: calc(17rpx * var(--font-scale, 1)); }
.intro-card { display: flex; align-items: center; gap: 14rpx; padding: 12rpx 0; }
.c-avatar,.small-avatar { display: block; border-radius: 50%; background: #F7E7DE; }
.c-avatar { width: 64rpx; height: 64rpx; font-size: calc(34rpx * var(--font-scale, 1)); }
.small-avatar,.user-avatar { width: 52rpx; height: 52rpx; flex-shrink: 0; font-size: calc(26rpx * var(--font-scale, 1)); }
.user-avatar { display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #FDE8DD; color: #C5532E; }
.intro-title { font-size: calc(29rpx * var(--font-scale, 1)); font-weight: 700; }
.messages { flex: 1; height: 0; min-height: 0; }
.message-list { padding: 24rpx 0; }
.message-row { display: flex; align-items: flex-start; gap: 12rpx; margin-bottom: 20rpx; }
.message-row.from-user { justify-content: flex-end; }
.message-bubble { min-width: 0; max-width: 76%; padding: 18rpx 22rpx; border-radius: 20rpx; line-height: 1.6; box-sizing: border-box; background: #FFFFFF; border: 1rpx solid #E7E5E2; word-break: break-all; overflow-wrap: break-word; white-space: pre-wrap; }
.message-row.from-user .message-bubble { background: #C5532E; color: #FFFFFF; border: 0; }
.quick { display: flex; flex-wrap: wrap; gap: 12rpx; }
.quick-item { color: #8C391D; background: #FDE8DD; border-radius: 999rpx; padding: 11rpx 17rpx; font-size: calc(23rpx * var(--font-scale, 1)); }
.composer { display: flex; gap: 14rpx; padding-top: 22rpx; }
.composer input { flex: 1; min-width: 0; background: #FFFFFF; border: 1rpx solid #E7E5E2; border-radius: 999rpx; padding: 0 20rpx; height: 76rpx; min-height: 76rpx; box-sizing: border-box; }
.send { flex: 0 0 76rpx; margin: 0; width: 76rpx; min-width: 76rpx; height: 76rpx; padding: 0; border-radius: 50%; font-size: calc(32rpx * var(--font-scale, 1)); line-height: 76rpx; }
