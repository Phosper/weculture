<page-meta page-style="{{fontPageStyle}}" />
<view class="topbar" style="padding-top:{{statusBarHeight}}px;height:{{navBarHeight}}px"><view class="topbar-inner" style="height:{{navContentHeight}}px;padding-right:{{navRightInset}}px"><view class="brand-lockup"><text class="topbar-brand">Weculture</text><text class="brand-subtitle">让文化融入生活</text></view></view></view>
<view class="page tab-page community">
  <view class="community-tabs"><view class="community-tab {{circle === 'city' ? 'active' : ''}}" data-circle="city" bindtap="changeCircle">同城</view><view class="community-tab {{circle === 'international' ? 'active' : ''}}" data-circle="international" bindtap="changeCircle">国际圈</view><view class="community-tab {{circle === 'campus' ? 'active' : ''}}" data-circle="campus" bindtap="changeCircle">校园圈</view></view>
  <view class="context"><view><view class="context-title">{{circleInfo.title}}</view><view class="context-sub">{{circle === 'campus' && user.school ? user.school.name + ' · 校内互助' : circle === 'city' && city ? city + ' · 文化生活' : circleInfo.subtitle}}</view></view><button size="mini" class="button-primary mini" bindtap="publish">发投稿</button></view>
  <block wx:if="{{circle === 'city'}}"><view class="city-tools"><picker mode="region" value="{{cityRegion}}" bindchange="chooseCity"><view class="city-selection"><view class="city-name {{!city ? 'city-placeholder' : ''}}">{{city || '请选择城市'}}</view><text class="city-action">{{city ? '切换 ›' : '选择 ›'}}</text></view></picker><button wx:if="{{automaticCityLocationEnabled}}" class="button-plain locate-button" loading="{{locating}}" disabled="{{locating || !user}}" bindtap="locateCity">{{locating ? '定位中' : '定位当前城市'}}</button></view><view class="location-hint">{{automaticCityLocationEnabled ? '仅用当前位置识别城市，可随时手动更换。' : '请选择浏览城市，可随时手动更换。'}}</view><view wx:if="{{automaticCityLocationEnabled && locationError}}" class="location-error">{{locationError}}<button wx:if="{{locationSettings}}" class="button-plain mini" bindtap="openLocationSettings">去开启定位</button></view></block>
  <scroll-view class="filters" scroll-x><view wx:for="{{filters}}" wx:key="key" class="filter {{type === item.key ? 'active' : ''}}" data-type="{{item.key}}" bindtap="changeType">{{item.label}}</view></scroll-view>
  <view wx:if="{{type === 'event'}}" class="event-time-panel"><view class="event-time-options"><view wx:for="{{eventTimes}}" wx:key="key" class="event-time-option {{eventTime === item.key ? 'active' : ''}}" data-event-time="{{item.key}}" bindtap="changeEventTime">{{item.label}}</view></view><text class="event-time-hint">{{eventTime === 'all' ? '选择具体时间，可按北京时间筛选未开始活动；报名状态以详情为准。' : '按北京时间筛选未开始活动；报名状态以详情为准。'}}</text></view>
  <view wx:if="{{circle === 'campus' && !user.verified}}" class="verify-card card"><view class="context-title">完成校园认证</view><view class="subtle">认证后可查看并发布本校内容</view><button class="button-primary mini" bindtap="verify">去认证</button></view>
  <view wx:if="{{circle === 'city' && !city && !error}}" class="empty">先选择城市，看看当地的文化生活。</view>
  <view wx:if="{{loading && posts.length === 0}}" class="empty">正在加载社区内容…</view><view wx:if="{{error}}" class="error">{{error}}<button class="button-plain mini" bindtap="retry">重新加载</button></view>
  <post-card class="community-post" wx:for="{{posts}}" wx:key="id" post="{{item}}" />
  <view wx:if="{{!loading && !error && posts.length === 0 && (circle !== 'campus' || user.verified) && (circle !== 'city' || city)}}" class="empty">{{circle === 'city' ? city + '暂时没有这类内容' : '这个圈子暂时没有这类内容'}}<button class="button-plain mini empty-publish" bindtap="publish">分享第一条投稿</button></view>
  <button wx:if="{{hasMore}}" class="button-plain load-more" loading="{{loading}}" disabled="{{loading}}" bindtap="loadMore">{{loading ? '正在加载…' : '加载更多'}}</button>
</view>
