.login-page { padding: 80rpx 48rpx; text-align: center; }
.login-art { width: 100%; height: 260rpx; border-radius: 24rpx; }
.login-title { margin-top: 56rpx; font-size: calc(42rpx * var(--font-scale, 1)); font-weight: 700; }
.login-description { margin: 20rpx 0 60rpx; color: #79747E; font-size: calc(26rpx * var(--font-scale, 1)); line-height: 1.6; }
.login-button { width: 100%; height: 88rpx; line-height: 88rpx; border-radius: 44rpx; font-size: calc(29rpx * var(--font-scale, 1)); }
.loading-hint { margin-top: 20rpx; color: #79747E; font-size: calc(22rpx * var(--font-scale, 1)); }
