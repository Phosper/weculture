<view class="page assistant"><view class="intro-card card"><view class="c-avatar">C</view><view><view class="intro-title">校园小C</view><view class="subtle">只回答学校已配置和平台通用的信息</view></view></view><scroll-view class="messages" scroll-y scroll-into-view="last"><view wx:for="{{messages}}" wx:key="id" id="{{index === messages.length - 1 ? 'last' : ''}}" class="message {{item.role}}">{{item.content}}</view></scroll-view><view class="quick"><view wx:for="{{actions}}" wx:key="id" class="quick-item" data-label="{{item.label}}" bindtap="useAction">{{item.label}}</view></view><view wx:if="{{error}}" class="error">{{error}}</view><view class="composer"><input value="{{content}}" placeholder="输入你的问题" bindinput="input" bindconfirm="send" confirm-type="send"/><button class="button-primary send" loading="{{sending}}" bindtap="send">发送</button></view></view>
