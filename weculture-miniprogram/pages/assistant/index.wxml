<page-meta page-style="{{fontPageStyle}}" />
<view class="topbar" style="padding-top:{{statusBarHeight}}px;height:{{navBarHeight}}px"><view class="topbar-inner" style="height:{{navContentHeight}}px;padding-right:{{navRightInset}}px"><text class="back" bindtap="back">‹</text><text class="topbar-title">校园小C</text></view></view>
<view class="page assistant-page" style="top:{{navBarHeight}}px">
  <view wx:if="{{events.length}}" class="events"><view class="events-title">近期校园活动</view><scroll-view scroll-x class="event-scroll"><view wx:for="{{events}}" wx:key="id" class="event-mini card" data-id="{{item.id}}" bindtap="openEvent"><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill"/><view class="event-mini-copy"><text class="event-mini-tag">校内活动</text><text class="event-mini-title">{{item.title}}</text><text class="subtle">{{item.event.startsAtText}}</text></view></view></scroll-view></view>
  <view class="intro-card"><image class="c-avatar" src="/assets/assistant-avatar.jpg" mode="aspectFill"/><view><view class="intro-title">校园小C</view><view class="subtle">你的校园文化伙伴</view></view></view>
  <scroll-view class="messages" scroll-y="{{true}}" scroll-top="{{scrollTop}}"><view class="message-list"><view wx:for="{{messages}}" wx:key="id" class="message-row {{item.role === 'user' ? 'from-user' : 'from-assistant'}}"><image wx:if="{{item.role === 'assistant'}}" class="small-avatar" src="/assets/assistant-avatar.jpg" mode="aspectFill"/><view class="message-bubble">{{item.content}}</view><view wx:if="{{item.role === 'user'}}" class="user-avatar">我</view></view></view></scroll-view>
  <view class="quick"><view wx:for="{{actions}}" wx:key="id" class="quick-item" data-label="{{item.label}}" bindtap="useAction">{{item.label}}</view></view>
  <view wx:if="{{error}}" class="error">{{error}}</view><view class="composer"><input value="{{content}}" placeholder="问问校园小C…" bindinput="input" bindconfirm="send" confirm-type="send"/><button class="button-primary send" loading="{{sending}}" bindtap="send">➤</button></view>
</view>
