<view class="page"><view class="header"><view><view class="title">{{user.school.name}}社区</view><view class="subtle">校内动态、活动与闲置信息</view></view><button class="button-primary mini" bindtap="publish">发布</button></view><scroll-view class="filters" scroll-x><view wx:for="{{filters}}" wx:key="key" class="filter {{type === item.key ? 'active' : ''}}" data-type="{{item.key}}" bindtap="changeType">{{item.label}}</view></scroll-view><view wx:if="{{loading}}" class="empty">正在加载校内内容...</view><view wx:if="{{error}}" class="error">{{error}}</view><post-card wx:for="{{posts}}" wx:key="id" post="{{item}}"/><view wx:if="{{!loading && !posts.length}}" class="empty">暂时没有内容，发布第一条校园动态吧。</view></view>
