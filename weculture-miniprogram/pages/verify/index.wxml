<view class="page"><view class="intro"><view class="title">完成校园认证</view><view class="subtle">认证后才可进入校内社区、报名活动和发布内容。</view></view><view class="card"><view wx:if="{{!user || !user.nickname}}"><view class="label">昵称</view><input data-field="nickname" value="{{nickname}}" placeholder="2至20个字符" bindinput="input"/></view><view class="label">学校邀请码</view><input data-field="code" value="{{code}}" placeholder="由学校运营人员发放" bindinput="input"/><view wx:if="{{error}}" class="error">{{error}}</view><button class="button-primary" disabled="{{!user}}" loading="{{loading}}" bindtap="submit">验证并加入学校</button></view><view class="tip">请向学校运营人员获取邀请码。</view></view>
