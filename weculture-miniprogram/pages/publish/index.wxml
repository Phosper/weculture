<view class="page"><view class="tabs"><view wx:for="{{['dynamic','event','market']}}" wx:key="*this" class="tab {{type === item ? 'active' : ''}}" data-type="{{item}}" bindtap="selectType">{{item === 'dynamic' ? '动态' : item === 'event' ? '活动' : '闲置'}}</view></view><view class="card form"><view class="label">标题</view><input data-field="title" value="{{title}}" maxlength="40" placeholder="说说你想分享的事" bindinput="input"/><view class="label">正文</view><textarea data-field="content" value="{{content}}" maxlength="2000" placeholder="分享校园文化、活动或闲置信息" bindinput="input"/><view class="label">标签</view><input data-field="tag" value="{{tag}}" placeholder="例如：校园文化" bindinput="input"/><block wx:if="{{type === 'event'}}"><view class="label">地点</view><input data-field="location" value="{{location}}" placeholder="活动地点" bindinput="input"/><view class="label">开始时间</view><input data-field="startsAt" value="{{startsAt}}" bindinput="input"/><view class="label">结束时间</view><input data-field="endsAt" value="{{endsAt}}" bindinput="input"/><view class="label">报名截止</view><input data-field="registrationDeadline" value="{{registrationDeadline}}" bindinput="input"/><view class="label">人数上限</view><input data-field="capacity" value="{{capacity}}" type="number" bindinput="input"/></block><view wx:if="{{error}}" class="error">{{error}}</view><button class="button-primary" loading="{{submitting}}" bindtap="submit">{{type === 'event' ? '提交活动审核' : '提交审核'}}</button></view><view class="notice">发布内容将进入审核队列，通过后仅向本校认证成员展示。</view></view>
