.post { margin-bottom: 20rpx; }.cover { width: 100%; height: 260rpx; margin: -24rpx -24rpx 20rpx; width: calc(100% + 48rpx); border-radius: 16rpx 16rpx 0 0; }.post-top,.post-bottom,.actions { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }.time,.author,.post-content { color:#756B66; font-size:24rpx; }.post-title { font-size:31rpx; font-weight:700; margin:16rpx 0 8rpx; }.post-content { line-height:1.6; }.post-bottom { border-top:1rpx solid #F0E9E5; margin-top:18rpx; padding-top:16rpx; }.actions { color:#8C391D; font-size:24rpx; }.event { margin-top:18rpx; padding:16rpx; display:flex; justify-content:space-between; background:#FFF6F1; border-radius:10rpx; color:#6D3826; font-size:23rpx; }.event-name { display:block; font-weight:600; margin-bottom:4rpx; }.event-action { align-self:center; }
