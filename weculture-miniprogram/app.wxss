page { background: #FCFBF8; color: #1C1B1F; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; font-size: calc(28rpx * var(--font-scale, 1)); }
.page { padding: 28rpx 32rpx 56rpx; padding-bottom: calc(56rpx + env(safe-area-inset-bottom)); box-sizing: border-box; overflow-wrap: break-word; }
.tab-page { padding-bottom: calc(148rpx + env(safe-area-inset-bottom)); }
.title { font-size: calc(42rpx * var(--font-scale, 1)); font-weight: 700; color: #1C1B1F; }
.subtle { color: #79747E; font-size: calc(25rpx * var(--font-scale, 1)); line-height: 1.5; }
.card { background: #FFFFFF; border: 1rpx solid #E7E5E2; border-radius: 20rpx; padding: 24rpx; box-sizing: border-box; }
.button-primary { background: #C5532E; color: #FFFFFF; border-radius: 12rpx; font-weight: 600; }
.button-primary[disabled] { background: #DDDAD5; color: #79747E; }
.button-primary::after, .button-plain::after { border: 0; }
.button-plain { background: #FFFFFF; border: 1rpx solid #CAC4CF; border-radius: 12rpx; color: #C5532E; }
.pill { display: inline-flex; align-items: center; padding: 7rpx 16rpx; border-radius: 999rpx; background: #FDE8DD; color: #C5532E; font-size: calc(22rpx * var(--font-scale, 1)); }
.empty { color: #79747E; text-align: center; padding: 72rpx 24rpx; line-height: 1.6; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin: 36rpx 0 20rpx; gap: 20rpx; }
.section-title { font-size: calc(32rpx * var(--font-scale, 1)); font-weight: 700; color: #1C1B1F; }
.error { color: #BA1A1A; padding: 18rpx 0; font-size: calc(24rpx * var(--font-scale, 1)); }
.topbar { width: 100%; background: #FFFFFF; box-sizing: border-box; }
.topbar-inner { display: flex; align-items: center; justify-content: space-between; padding: 0 100px 0 32rpx; box-sizing: border-box; min-width: 0; }
.topbar-title { font-size: calc(34rpx * var(--font-scale, 1)); font-weight: 700; line-height: 1.2; white-space: nowrap; }
.brand-lockup { display: flex; flex-direction: column; justify-content: center; min-width: 0; }
.topbar-brand { font-family: Georgia, "Times New Roman", serif; font-size: calc(37rpx * var(--font-scale, 1)); font-weight: 700; color: #1C1B1F; letter-spacing: -1rpx; line-height: 1.05; }
.brand-subtitle { margin-top: 4rpx; color: #79747E; font-size: calc(18rpx * var(--font-scale, 1)); letter-spacing: 2rpx; line-height: 1.1; }
button,input,textarea { font-family: inherit; }
.topbar-action { font-size: calc(33rpx * var(--font-scale, 1)); color: #C5532E; }
