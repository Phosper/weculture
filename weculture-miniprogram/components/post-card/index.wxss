.post { display: flex; flex-direction: column; overflow: hidden; padding: 0; margin-bottom: 20rpx; border-radius: 20rpx; background: #FFFFFF; border: 1rpx solid #EAE7E2; box-shadow: 0 7rpx 22rpx rgba(28,27,31,.045); }
.post .author-row { order: 0; }
.post .post-body { order: 1; padding-top: 2rpx; }
.post .cover-wrap { order: 2; margin: 0 20rpx; border-radius: 15rpx; overflow: hidden; }
.post .event-row { order: 3; }
.post .post-bottom { order: 4; }
.post .cover { height: 340rpx; }
.post .post-title { font-size: calc(28rpx * var(--font-scale, 1)); }
.author-row { display: flex; align-items: center; gap: 12rpx; padding: 18rpx 20rpx; min-width: 0; }
.author-link { display: flex; align-items: center; gap: 12rpx; flex: 1; min-width: 0; }
.author-avatar,.author-initial { width: 54rpx; height: 54rpx; border-radius: 50%; flex-shrink: 0; }
.author-initial { display: flex; align-items: center; justify-content: center; background: #FDE8DD; color: #C5532E; font-size: calc(24rpx * var(--font-scale, 1)); font-weight: 700; }
.author-text { display: flex; flex-direction: column; flex: 1; min-width: 0; }
.author-name { font-size: calc(24rpx * var(--font-scale, 1)); font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.time { font-size: calc(19rpx * var(--font-scale, 1)); color: #79747E; line-height: 1.5; word-break: break-all; }
.more-mark { color: #79747E; font-size: calc(28rpx * var(--font-scale, 1)); }
.cover-wrap { position: relative; }
.cover { display: block; width: 100%; height: 330rpx; }
.cover.tall { height: 380rpx; }
.cover-collage { display: flex; width: 100%; height: 340rpx; gap: 7rpx; overflow: hidden; }
.collage-main { display: block; width: 67%; height: 100%; flex-shrink: 0; }
.collage-side { display: flex; flex: 1; flex-direction: column; gap: 7rpx; min-width: 0; }
.collage-side image { display: block; width: 100%; height: 0; flex: 1; }
.image-tag { position: absolute; left: 16rpx; bottom: 16rpx; max-width: calc(100% - 32rpx); box-sizing: border-box; word-break: break-all; background: #C5532E; color: #FFFFFF; border-radius: 999rpx; padding: 5rpx 12rpx; font-size: calc(19rpx * var(--font-scale, 1)); }
.post-body { padding: 20rpx; }
.post-meta { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 6rpx 12rpx; min-width: 0; margin-bottom: 8rpx; }
.circle-label,.plain-tag { display: block; max-width: 100%; min-width: 0; line-height: 1.5; white-space: normal; word-break: break-all; }
.circle-label { color: #79747E; font-size: calc(20rpx * var(--font-scale, 1)); }
.plain-tag { color: #C5532E; font-size: calc(20rpx * var(--font-scale, 1)); font-weight: 700; }
.post-title { font-size: calc(29rpx * var(--font-scale, 1)); font-weight: 700; line-height: 1.38; display: -webkit-box; overflow: hidden; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.post-content { font-size: calc(23rpx * var(--font-scale, 1)); color: #49454F; line-height: 1.5; margin-top: 10rpx; display: -webkit-box; overflow: hidden; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.post-bottom { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 20rpx 18rpx; color: #C5532E; font-size: calc(22rpx * var(--font-scale, 1)); }
.event-row { margin: 0 20rpx 8rpx; border-top: 1rpx solid #E7E5E2; padding: 14rpx 0 0; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.event-row > view { flex: 1; min-width: 0; word-break: break-all; }
.event-name { display: block; font-size: calc(22rpx * var(--font-scale, 1)); font-weight: 700; }
.event-time { display: block; font-size: calc(20rpx * var(--font-scale, 1)); color: #79747E; }
.event-action { flex-shrink: 0; font-size: calc(21rpx * var(--font-scale, 1)); color: #C5532E; font-weight: 700; white-space: nowrap; }
.compact .author-row { padding: 12rpx; gap: 8rpx; }
.compact .author-link { gap: 8rpx; }
.compact { display: flex; flex-direction: column; background: #FFFFFF; border: 1rpx solid #EAE7E2; border-radius: 20rpx; box-shadow: 0 7rpx 22rpx rgba(28,27,31,.045); }
.compact .cover-wrap { order: 0; }
.compact .cover-wrap { margin: 0; border-radius: 0; }
.compact .post-body { order: 1; }
.compact .author-row { order: 2; padding-top: 0; }
.compact .post-bottom { order: 3; }
.compact .author-avatar,.compact .author-initial { width: 42rpx; height: 42rpx; font-size: calc(19rpx * var(--font-scale, 1)); }
.compact .author-name { font-size: calc(20rpx * var(--font-scale, 1)); }
.compact .time { font-size: calc(17rpx * var(--font-scale, 1)); }
.compact .more-mark { display: none; }
.compact .cover { height: 240rpx; }
.compact .cover.tall { height: 310rpx; }
.compact .post-body { padding: 14rpx 14rpx 10rpx; min-height: 66rpx; }
.compact .post-meta { gap: 4rpx 8rpx; margin-bottom: 6rpx; }
.compact .circle-label,.compact .plain-tag { font-size: calc(18rpx * var(--font-scale, 1)); }
.compact .post-title { font-size: calc(22rpx * var(--font-scale, 1)); }
.compact .image-tag { font-size: calc(17rpx * var(--font-scale, 1)); left: 10rpx; bottom: 10rpx; }
.compact .post-bottom { padding: 7rpx 14rpx 15rpx; font-size: calc(20rpx * var(--font-scale, 1)); }
