.intro { margin:8rpx 0 24rpx; }.label { font-size:25rpx; color:#675E5A; margin:20rpx 0 10rpx; }.planner input { border-bottom:1rpx solid #E6DED9; padding:14rpx 0; }.choices { display:flex; flex-wrap:wrap; gap:12rpx; }.choice { padding:12rpx 18rpx; background:#F7F2EF; color:#756B66; border-radius:999rpx; font-size:24rpx; }.choice.selected { color:#FFFFFF; background:#C5532E; }.planner button { margin-top:28rpx; }.route { display:flex; padding:0; overflow:hidden; margin-bottom:18rpx; }.route image { width:200rpx; height:230rpx; }.route-copy { flex:1; padding:20rpx; min-width:0; }.route-title { font-size:29rpx; font-weight:700; margin-bottom:8rpx; }.highlights { margin:12rpx 0; color:#8C391D; font-size:23rpx; }.route-foot { display:flex; justify-content:space-between; align-items:center; }.price { color:#C5532E; font-weight:700; }.small { font-size:22rpx; line-height:2; margin:0; }
