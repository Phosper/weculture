<view class="page"><view class="profile card"><view class="portrait">{{avatarText}}</view><view class="profile-copy"><view class="name">{{user.nickname || '新用户'}}</view><view class="subtle">{{user.verified ? user.school.name + ' · 已认证成员' : '未完成校园认证'}}</view></view></view><view wx:if="{{!user.verified}}" class="card verify"><view><view class="verify-title">校内社区待解锁</view><view class="subtle">认证后可发布动态、报名活动。</view></view><button class="button-primary short" bindtap="verify">去认证</button></view><view class="section-head"><text class="section-title">我的计划</text><text class="subtle">路线与活动</text></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{!plans.length}}" class="empty">还没有计划，去旅行页加入路线或报名活动吧。</view><view wx:for="{{plans}}" wx:key="id" class="plan card"><view class="pill">{{item.type === 'event' ? '校内活动' : '旅行路线'}}</view><view class="plan-title">{{item.title}}</view><view class="subtle">{{item.type === 'event' ? item.location : item.stopsText}}</view></view><view class="section-head"><text class="section-title">我的投稿</text><text class="subtle">审核状态</text></view><view wx:if="{{!posts.length}}" class="subtle">暂未发布内容</view><view wx:for="{{posts}}" wx:key="id" class="post-status card"><view><view class="post-title">{{item.title}}</view><view wx:if="{{item.status === 'rejected'}}" class="reject">驳回原因：{{item.rejectionReason}}</view></view><view class="status {{item.status}}">{{item.status === 'approved' ? '已发布' : item.status === 'pending' ? '审核中' : item.status === 'rejected' ? '已驳回' : '已下架'}}</view></view><button class="logout" bindtap="logout">退出登录</button></view>
