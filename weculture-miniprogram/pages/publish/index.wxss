.publish-page { padding-top: 20rpx; }
.tabs { display: flex; background: #FFFFFF; border: 1rpx solid #E7E5E2; border-radius: 12rpx; overflow: hidden; margin: 0 0 22rpx; }
.tab { flex: 1; padding: 18rpx 0; text-align: center; color: #49454F; font-size: calc(25rpx * var(--font-scale, 1)); }
.tab.active { color: #FFFFFF; background: #C5532E; font-weight: 700; }
.form { padding: 25rpx 27rpx; }
.label { font-size: calc(24rpx * var(--font-scale, 1)); font-weight: 600; color: #49454F; margin: 25rpx 0 9rpx; }
.form input,.form textarea { width: 100%; border-bottom: 1rpx solid #E7E5E2; padding: 16rpx 0; box-sizing: border-box; font-size: calc(25rpx * var(--font-scale, 1)); }
.form input { height: 88rpx; min-height: 88rpx; padding: 0; line-height: 1.5; }
.form textarea { min-height: 160rpx; height: 160rpx; }
.audience { display: flex; gap: 16rpx; }
.audience view { flex: 1; min-width: 0; background: #F2F1EE; border-radius: 10rpx; padding: 18rpx 14rpx; color: #49454F; font-size: calc(22rpx * var(--font-scale, 1)); text-align: center; }
.audience view.active { background: #FDE8DD; color: #C5532E; font-weight: 700; }
.audience-note { margin-top: 14rpx; color: #79747E; font-size: calc(22rpx * var(--font-scale, 1)); line-height: 1.6; word-break: break-all; }
.audience-note .verify-button { display: inline-block; margin: 12rpx 0 0; padding: 0 20rpx; font-size: calc(23rpx * var(--font-scale, 1)); line-height: 2.3; }
.language-picker { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 76rpx; border-bottom: 1rpx solid #E7E5E2; font-size: calc(25rpx * var(--font-scale, 1)); }
.language-picker text { flex-shrink: 0; color: #C5532E; font-size: calc(22rpx * var(--font-scale, 1)); }
.city-picker > view { flex: 1; min-width: 0; word-break: break-all; }
.city-placeholder { color: #79747E; }
.city-hint { margin-top: 10rpx; font-size: calc(21rpx * var(--font-scale, 1)); line-height: 1.5; color: #79747E; }
.publish-location-tools { margin-top: 14rpx; }
.locate-button { display: inline-block; width: auto; margin: 0; padding: 0 18rpx; font-size: calc(22rpx * var(--font-scale, 1)); line-height: 2.8; border-radius: 12rpx; }
.location-error { margin-top: 12rpx; color: #A43C26; font-size: calc(22rpx * var(--font-scale, 1)); line-height: 1.6; word-break: break-all; }
.location-error button { margin-top: 10rpx; }
.media-add { height: 150rpx; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 8rpx; border: 1rpx dashed #CAC4CF; border-radius: 11rpx; color: #C5532E; background: #FDFCFA; font-size: calc(22rpx * var(--font-scale, 1)); }
.media-add text:first-child { font-size: calc(43rpx * var(--font-scale, 1)); line-height: 1; }
.media-preview { position: relative; width: 180rpx; height: 150rpx; }
.media-preview image { width: 100%; height: 100%; border-radius: 8rpx; }
.media-preview text { position: absolute; right: 0; bottom: 0; background: #C5532E; color: #FFFFFF; font-size: calc(20rpx * var(--font-scale, 1)); padding: 7rpx; }
.date-row { display: flex; gap: 15rpx; }
.date-row picker { flex: 1; min-width: 0; }
.date-row picker:first-child { flex: 1.6; }
.date-row picker view { border: 1rpx solid #CAC4CF; background: #FDFCFA; border-radius: 8rpx; padding: 15rpx 11rpx; text-align: center; color: #C5532E; font-size: calc(23rpx * var(--font-scale, 1)); line-height: 1.5; }
.submit { margin-top: 34rpx; font-size: calc(27rpx * var(--font-scale, 1)); }
.notice { padding: 18rpx 10rpx; font-size: calc(22rpx * var(--font-scale, 1)); color: #79747E; line-height: 1.5; }
.publish-intro { margin: 4rpx 0 28rpx; }
.publish-intro .subtle { margin-top: 10rpx; }
.draft-note { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: -8rpx 0 18rpx; padding: 16rpx 20rpx; border: 1rpx solid #E9DAD0; border-radius: 14rpx; background: #FCF6F1; color: #77665D; font-size: calc(22rpx * var(--font-scale, 1)); line-height: 1.6; }
.draft-note text { flex: 1; min-width: 0; }
.draft-note button { flex-shrink: 0; margin: 0; padding: 0 10rpx; font-size: calc(22rpx * var(--font-scale, 1)); }
