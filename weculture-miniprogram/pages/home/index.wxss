.home { padding-top: 0; }
.search-modes { display: flex; align-items: center; gap: 28rpx; margin: 0 0 16rpx; }
.search-mode { padding: 16rpx 2rpx 10rpx; border-bottom: 4rpx solid transparent; color: #79747E; font-size: calc(27rpx * var(--font-scale, 1)); }
.search-mode.selected { color: #93391D; border-bottom-color: #C5532E; font-weight: 700; }
.user-search-heading { display: flex; flex-direction: column; gap: 10rpx; padding: 10rpx 0 22rpx; }
.user-search-hint { color: #625D65; font-size: calc(23rpx * var(--font-scale, 1)); line-height: 1.6; }
.author-list { border-top: 1rpx solid #E7E5E2; }
.author-row { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 0; border-bottom: 1rpx solid #E7E5E2; }
.author-avatar { display: block; width: 96rpx; height: 96rpx; flex-shrink: 0; border-radius: 50%; background: #ECEAE7; }
.author-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.author-name { color: #1C1B1F; font-size: calc(28rpx * var(--font-scale, 1)); font-weight: 600; overflow-wrap: anywhere; }
.author-work-count { color: #79747E; font-size: calc(22rpx * var(--font-scale, 1)); }
.author-enter { flex-shrink: 0; color: #93391D; font-size: calc(34rpx * var(--font-scale, 1)); padding: 12rpx; }
.discovery-banner { position: relative; height: 205rpx; margin: 10rpx 0 20rpx; border-radius: 22rpx; overflow: hidden; background: #D7D3C7; }
.discovery-banner image { width: 100%; height: 100%; }
.banner-shade { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: linear-gradient(90deg, rgba(24,24,20,.72), rgba(24,24,20,.08)); }
.banner-copy { position: absolute; left: 28rpx; top: 25rpx; display: flex; flex-direction: column; align-items: flex-start; color: #FFFFFF; }
.banner-kicker { font-size: calc(20rpx * var(--font-scale, 1)); letter-spacing: 3rpx; }
.banner-title { margin-top: 9rpx; font-size: calc(34rpx * var(--font-scale, 1)); font-weight: 700; }
.banner-link { margin-top: 15rpx; padding: 7rpx 15rpx; border: 1rpx solid rgba(255,255,255,.75); border-radius: 999rpx; font-size: calc(20rpx * var(--font-scale, 1)); }
.feed-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12rpx; margin-bottom: 20rpx; }
.feed-subtitle { color: #79747E; font-size: calc(21rpx * var(--font-scale, 1)); }
.feed-tabs { display: flex; gap: 12rpx; margin: 0 0 18rpx; flex-wrap: wrap; }
.feed-tab { padding: 12rpx 28rpx; border-bottom: 4rpx solid transparent; color: #79747E; font-size: calc(28rpx * var(--font-scale, 1)); }
.feed-tab.selected { color: #93391D; border-bottom-color: #C5532E; font-weight: 700; }
.type-filters { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 22rpx; }
.type-filter { padding: 10rpx 20rpx; border-radius: 999rpx; background: #ECEAE7; color: #625D65; font-size: calc(22rpx * var(--font-scale, 1)); }
.type-filter.selected { background: #F7E7DE; color: #93391D; }
.event-time-panel { margin: -4rpx 0 24rpx; padding: 16rpx 18rpx; border: 1rpx solid #E9DAD0; border-radius: 18rpx; background: #FCF6F1; }
.event-time-options { display: flex; flex-wrap: wrap; gap: 10rpx; }
.event-time-option { padding: 9rpx 16rpx; border-radius: 999rpx; color: #77665D; font-size: calc(22rpx * var(--font-scale, 1)); }
.event-time-option.selected { background: #F0D8C9; color: #93391D; font-weight: 600; }
.event-time-hint { display: block; margin-top: 12rpx; color: #87756B; font-size: calc(20rpx * var(--font-scale, 1)); line-height: 1.6; }
.feed-empty { display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 36rpx 16rpx; text-align: center; }
.empty-title { font-size: calc(28rpx * var(--font-scale, 1)); font-weight: 700; }
.empty-description { color: #79747E; font-size: calc(23rpx * var(--font-scale, 1)); line-height: 1.7; }
.feed-empty button { max-width: 100%; margin: 0; padding: 0 26rpx; font-size: calc(24rpx * var(--font-scale, 1)); white-space: normal; }
.load-more { margin: 22rpx auto; font-size: calc(24rpx * var(--font-scale, 1)); }
.feed-end { padding: 18rpx 0; color: #79747E; text-align: center; font-size: calc(22rpx * var(--font-scale, 1)); }
.search { display: flex; align-items: center; height: 74rpx; border-radius: 999rpx; background: #ECEAE7; padding: 0 18rpx; margin-bottom: 20rpx; }
.search-mark { font-size: calc(34rpx * var(--font-scale, 1)); color: #79747E; margin-right: 10rpx; }
.search input { flex: 1; min-width: 0; font-size: calc(24rpx * var(--font-scale, 1)); }
.search-action { color: #C5532E; font-size: calc(23rpx * var(--font-scale, 1)); font-weight: 600; }
.search input { height: 58rpx; line-height: 1.5; }
.search-action { flex-shrink: 0; margin-left: 10rpx; }
.search-clear { flex-shrink: 0; color: #79747E; font-size: calc(21rpx * var(--font-scale, 1)); margin-left: 10rpx; }
.verify-card { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 18rpx; }
.verify-title { font-size: calc(25rpx * var(--font-scale, 1)); font-weight: 700; }
.compact-button { margin: 0; padding: 0 18rpx; font-size: calc(22rpx * var(--font-scale, 1)); line-height: 2.4; white-space: nowrap; }
.assistant-strip { display: flex; align-items: center; gap: 14rpx; background: #FFFFFF; border: 1rpx solid #ECEAE6; border-radius: 20rpx; padding: 18rpx 20rpx; margin-bottom: 30rpx; box-shadow: 0 7rpx 20rpx rgba(28,27,31,.035); }
.assistant-mark { display: block; width: 66rpx; height: 66rpx; flex-shrink: 0; border-radius: 50%; background: #F7E7DE; }
.assistant-copy { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.assistant-title { color: #1C1B1F; font-size: calc(25rpx * var(--font-scale, 1)); font-weight: 700; }
.assistant-description { color: #79747E; font-size: calc(21rpx * var(--font-scale, 1)); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.arrow { color: #C5532E; font-size: calc(38rpx * var(--font-scale, 1)); }
.feed-grid { display: flex; align-items: flex-start; gap: 16rpx; }
.feed-column { width: calc((100% - 16rpx) / 2); min-width: 0; }
.verify-link { color: #93391D; text-align: center; font-size: calc(22rpx * var(--font-scale, 1)); padding: 16rpx 0 26rpx; }
.follow-empty { display: flex; flex-direction: column; align-items: center; gap: 14rpx; padding: 110rpx 30rpx; text-align: center; }
.follow-title { font-size: calc(29rpx * var(--font-scale, 1)); font-weight: 700; }
.follow-empty button { margin-top: 18rpx; font-size: calc(23rpx * var(--font-scale, 1)); }
