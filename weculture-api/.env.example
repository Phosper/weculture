PORT=3000
NODE_ENV=development
JWT_SECRET=replace-this-in-production-with-at-least-32-random-characters
AUTO_APPROVE=false
SEED_DEMO_DATA=true
DB_TYPE=sqljs
DB_LOCATION=weculture.sqlite
DB_AUTOSAVE=true
DB_SYNCHRONIZE=true

# Production MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=weculture
DB_PASSWORD=replace-this
DB_DATABASE=weculture
DB_MIGRATIONS_RUN=false
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
CORS_ORIGINS=https://admin.example.com

# WeChat login (required in production)
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Required only when SEED_DEMO_DATA=true in production
ADMIN_INITIAL_PASSWORD=
OPERATOR_INITIAL_PASSWORD=
REVIEWER_INITIAL_PASSWORD=
SCHOOL_INVITE_CODE=
